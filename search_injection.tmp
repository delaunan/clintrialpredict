import pandas as pd
import json

# <REF:PROD_EXPORT_CODE_V3>
# 4. Prepare Taxonomy Snapshot for API (Sync with api/main.py)
taxonomy_payload = {
    "FEATURE_REGISTRY": {k: v for k, v in FEATURE_REGISTRY.items()},
    "UI_SCHEMA": UI_SCHEMA
}
with open(MODELS_PATH / "taxonomy_01.json", "w") as f:
    json.dump(taxonomy_payload, f, indent=4)

# 5. ENHANCED SEARCH IDENTITY
def create_search_label(row):
    acro = str(row['acronym']).strip() if pd.notna(row['acronym']) else ""
    drug = str(row['alpha_drug_name']).strip() if pd.notna(row['alpha_drug_name']) else "Unknown Drug"
    sponsor = str(row['lead_sponsor_canonical']).strip() if pd.notna(row['lead_sponsor_canonical']) else "Unknown Sponsor"
    ta = str(row['therapeutic_area']).strip() if pd.notna(row['therapeutic_area']) else "Unclassified"
    year = str(int(row['start_year'])) if pd.notna(row['start_year']) else "YYYY"
    
    prefix = f"[{acro}] " if acro and acro.lower() != 'nan' else ""
    return f"{prefix}{drug} ({sponsor}) | {ta} ({year})"

df_full['ui_search_label'] = df_full.apply(create_search_label, axis=1)

# 6. Save Final Search Registry for Frontend
df_full.to_csv(FRONTEND_DATA_PATH / "search_registry.csv", index=True)

print("✅ All artifacts persisted. Production Engine Ready.")
print(f"   - Model:      {MODELS_PATH / 'model_prod_01.joblib'}")
print(f"   - Taxonomy:   {MODELS_PATH / 'taxonomy_01.json'}")
print(f"   - Registry:   {FRONTEND_DATA_PATH / 'search_registry.csv'}")
